<div id="<%= dom_id report %>">
  <% owner = report.user %>
  <p>
    <strong>User:</strong>
    <%= owner.name.empty? ? owner.email : owner.name %>
  </p>

  <p>
    <strong>Posted_at:</strong>
    <%= report.created_at %>
  </p>

  <p>
    <strong>Title:</strong>
    <%= report.title %>
  </p>

  <p>
    <strong>Body:</strong>
    <%= report.body %>
  </p>

</div>
