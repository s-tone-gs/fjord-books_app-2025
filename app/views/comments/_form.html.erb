
<%= form_with(model: [commentable, comment]) do |form| %>
  <% if comment.errors.any? %>
    <div style="color: red">
      <h2>○○個のエラーです</h2>

      <ul>
        <% comment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :body, style: "display: block" %>
    <%= form.textarea :body, required: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
