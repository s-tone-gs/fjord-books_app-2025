<div id="<%= dom_id comment %>">
  <% owner = comment.user %>
  <p>
    <strong><%= Comment.human_attribute_name(:user) %>:<%= comment.user.name_or_email %></strong>
  </p>

  <p>
    <strong><%= Comment.human_attribute_name(:created_at) %>:</strong>
    <%= comment.created_at %>
  </p>

  <p>
    <strong><%= Comment.human_attribute_name(:body) %>:</strong>
    <%= comment.body %>
  </p>

</div>
<%= button_to t('views.common.destroy', name: Comment.model_name.human), comment, method: :delete  if comment.user == current_user %>
